{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": {
      "windows-shell/generated/payload/": "shell-extension/"
    },
    "windows": {
      "wix": {
        "version": "0.9.0",
        "fragmentPaths": ["windows-shell/installer.wxs"],
        "componentRefs": ["TeraxShellRegistration"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terax",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      }
    ]
  }
}
